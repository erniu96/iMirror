/* Settings */
"General" = "通用";
"Pairing" = "配对";
"Receiver Name:" = "接收器名称：";
"Shown as:" = "显示为：";
"Apply and Restart Receiver" = "应用并重启接收器";
"This is the name to choose in Screen Mirroring on your iPhone or iPad. The tag after it tells your Macs apart." = "在 iPhone 或 iPad 的“屏幕镜像”中选择这个名称。后面的标记用来区分你的多台 Mac。";
"Keep mirroring windows on top" = "投屏窗口始终置顶";
