/* Settings */
"General" = "一般";
"Pairing" = "配對";
"Receiver Name:" = "接收器名稱：";
"Shown as:" = "顯示為：";
"Apply and Restart Receiver" = "套用並重新啟動接收器";
"This is the name to choose in Screen Mirroring on your iPhone or iPad. The tag after it tells your Macs apart." = "在 iPhone 或 iPad 的「螢幕鏡像輸出」中選擇這個名稱。後面的標記用來區分你的多部 Mac。";
"Keep mirroring windows on top" = "鏡像視窗永遠在最上層";
