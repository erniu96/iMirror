/* Receiver status */
"Receiver stopped" = "受信を停止しています";
"Starting receiver…" = "受信を開始しています…";
"Waiting for a device" = "デバイスを待っています";
"Waiting for the code" = "コードの入力を待っています";
"Receiving mirroring" = "ミラーリングを受信中";
"Receiving from %lld devices" = "%lld台のデバイスから受信中";
