"OK" = "OK";
"Couldn’t Start the Receiver" = "受信を開始できません";
"Couldn’t Rename the Receiver" = "受信側の名前を変更できません";
"Couldn’t Change Open at Login" = "ログイン時に開く設定を変更できません";
"Couldn’t Forget Paired Devices" = "ペアリング済みデバイスの登録を解除できません";
"Couldn’t Reset the Receiver Identity" = "受信側のIDをリセットできません";
"Couldn’t Open a Window for “%@”" = "「%@」のウインドウを開けません";
"Couldn’t Show “%@”" = "「%@」の画面を表示できません";
"Couldn’t Play Sound" = "サウンドを再生できません";

/* Error details */
